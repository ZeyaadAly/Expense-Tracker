# Public Express API prefix. Restart dev after changing; production embeds it at build time.
# Keep /api/v1 for V1. V2 alone normalizes this prefix to /api/v2.
# V2 also accepts the backend origin or /api/v2; those values are NOT compatible with V1.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# V2 Auth helper configuration; still unused by V1 and the fixture prototype.
# Copy the active publishable key privately from Supabase > Settings > API Keys.
# Never use a service-role/secret key, database password or JWT signing secret here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=






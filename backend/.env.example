PORT=4000
CLIENT_ORIGIN=http://localhost:3000
# Server-only: copy the full URI from Supabase > Connect into backend/.env.
# Replace the example host/user/password; percent-encode reserved password characters.
# For an IPv4-only network, copy the Session pooler URI from the dashboard.
DATABASE_URL=postgresql://expense_tracker_app.YOUR_PROJECT_REF:YOUR_PERCENT_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres
# Relative paths resolve from backend/. Certificate and hostname checks stay enabled.
DATABASE_SSL_CA_FILE=certs/supabase-ca.crt
# T09 nonsecret JWT-verification metadata; required only by protected V2 middleware.
# Derive issuer as <SUPABASE_URL>/auth/v1 and JWKS as issuer/.well-known/jwks.json.
# Audience authenticated and algorithm ES256 are pinned in code. No admin credential needed.
# HTTPS hosted origin; HTTP loopback allowed only outside production. V1/health need no Auth config.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# T24 server-only dedicated cursor key: 32 cryptographically random bytes encoded as 64 hex characters.
# Generate privately; leave empty for V1-only operation. V2 transaction lists fail safely with 503 until set.
# Share the same key across backend instances. Rotation invalidates outstanding 24-hour cursors.
CURSOR_SIGNING_SECRET=
